
; ── HenWen browser transmitter (spike, 2026-07-05) ────────────────────────
; One WebRTC endpoint for the kiosk's browser-mic TX. Signaling arrives as
; SIP over WebSocket on the loopback-only builtin HTTP server (Apache
; terminates WSS with the existing cert and proxies /asterisk-ws to it).
; webrtc=yes turns on DTLS-SRTP, ICE, AVPF, and rtcp-mux in one switch.
; ulaw only: WebRTC browsers must support G.711, app_rpt is native ulaw —
; zero transcoding. The endpoint's context exposes exactly one extension
; (our node in phone-control mode), so a leaked credential can't dial
; anywhere else.

[henwen-ws]
type=transport
protocol=ws
bind=0.0.0.0

[henwen-tx]
type=endpoint
context=henwen-browser-tx
disallow=all
allow=ulaw
webrtc=yes
dtls_auto_generate_cert=yes
auth=henwen-tx-auth
aors=henwen-tx
callerid="HenWen-Web" <__NODENUM__>
; Tear the channel down when media stops. A browser that vanishes without
; sending BYE (tab closed, laptop slept, WiFi dropped) otherwise leaves
; Rpt(<node>,P) up forever -- confirmed live 2026-10-30 on a phone-mode
; channel 27 HOURS old, still listed by `rpt nodes` as a transceive peer,
; while res_pjsip retried an in-dialog request every 30s for ~3,200 log
; lines. Session timers (timers=yes, 1800s) do NOT catch this. The browser
; sends RTP continuously the whole time it is armed -- the mic track is
; never disabled, PTT only sends DTMF (see _txKey() in status.html) -- so
; no inbound RTP always means the session is dead or its media path never
; came up, and both should hang up rather than linger. The sibling
; henwen-oink-tx endpoint already did this; browser TX just never got it.
rtp_timeout=60
rtp_timeout_hold=60

[henwen-tx-auth]
type=auth
auth_type=userpass
username=henwen-tx
password=__TXSECRET__

[henwen-tx]
type=aor
max_contacts=3
remove_existing=yes
; ── end HenWen browser transmitter ────────────────────────────────────────
